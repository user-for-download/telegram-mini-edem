.tmp/
build/
dist/
# Сгенерированный Prisma-клиент (v7, provider "prisma-client"): собирается
# `prisma generate` (npm run db:generate) и компилируется tsc в dist.
backend/src/generated/
coverage/
.DS_Store
*.log
# Runtime audit journals (migration runs, tg-migration-23): durable output
# of the deployment host, not source. Never commit run artifacts.
backend/logs/
.env
!.env.example
backend/.env
!backend/.env.test
# Канонический lockfile: package-lock.json. Установка — npm ci везде
# (CI, Dockerfile). Менеджер пакетов — только npm: bun.lock/bun.lockb
# игнорируем и не коммитим — два lockfile = дрейф графа зависимостей
# между CI и прод-образами (audit: reproducible dependency installation).
bun.lock
bun.lockb
*.db
*.db-journal
.opencode/
prc.json
assets/
# Исходные изображения мини-аппа (онбординг и т.п.) — хранятся в репозитории,
# в отличие от build-артефактов dist/**/assets.
!mini-app/src/assets/
dump/
fix/
opencode.json
run_workflow.sh

# Agent skills (local installs, full permissions) — never commit
.agents/
