{
  "name": "edem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "telegram-app",
    "backend",
    "packages/*",
    "webapp"
  ],
  "scripts": {
    "dev": "npm run build:contracts && npm run db:generate && VITE_API_TARGET=${VITE_API_TARGET:-http://127.0.0.1:3011} concurrently \"npm run dev:backend\" \"npm run dev:tg\"",
    "dev:backend": "BACKEND_PORT=${BACKEND_PORT:-3011} npm run dev --workspace=backend",
    "dev:tg": "VITE_API_TARGET=${VITE_API_TARGET:-http://127.0.0.1:3011} npm run dev --workspace=telegram-app",
    "build:tg": "npm run build --workspace=telegram-app",
    "build": "npm run build:contracts && npm run db:generate && npm run build --workspace=backend && npm run build:tg && npm run build --workspace=webapp",
    "start": "node backend/dist/src/index.js",
    "build:contracts": "npm run build --workspace=packages/contracts",
    "db:push": "npm run db:push --workspace=backend",
    "db:push:force": "npm run db:push:force --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:seed:cities": "npm run db:seed:cities --workspace=backend",
    "prisma:validate": "npm run prisma:validate --workspace=backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "rm -rf backend/dist telegram-app/dist webapp/dist packages/contracts/dist",
    "lint": "npm run typecheck",
    "lint:eslint": "eslint .",
    "lint:eslint:backend": "eslint backend",
    "lint:eslint:tg-app": "eslint telegram-app",
    "lint:eslint:webapp": "eslint webapp",
    "lint:eslint:contracts": "eslint packages/contracts",
    "format:check": "node scripts/format-check.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "load:test": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@sentry/react": "^10.73.0",
    "@tanstack/react-query": "^5.102.8",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.2.2"
  }
}
