# ─── Docker Compose (production) ─────────────────────────────────────────────
# Compose сам собирает DATABASE_URL из POSTGRES_PASSWORD (см. docker-compose.yml);
# отдельный DATABASE_URL здесь не используется.
POSTGRES_PASSWORD=
# Адрес публикации порта backend (docker-compose.yml). Дефолт — 127.0.0.1
# (reverse proxy на том же хосте). Для прокси на отдельном хосте — 0.0.0.0
# и firewall-правило на порт 3000 (только Traefik/nginx).
BACKEND_BIND_ADDR=
# Адрес публикации порта админ-панели webapp (docker-compose.yml). Дефолт —
# 127.0.0.1 (reverse proxy на том же хосте). Для прокси на отдельном хосте —
# 0.0.0.0 и firewall-правило на порт 3014.
WEBAPP_BIND_ADDR=
NODE_ENV=
ALLOW_DEV_AUTH=
JWT_SECRET=
CORS_ORIGINS=
LOG_LEVEL=
SENTRY_DSN=
# Bearer token protecting /metrics in production. Without it, /metrics returns 404.
METRICS_TOKEN=
REFRESH_RATE_WINDOW_MS=
REFRESH_RATE_MAX=

# ─── Rate limits ────────────────────────────────────────────────────────────
# IP-based: публичные GET (поиск, профили, отзывы) и мутации (в минуту).
PUBLIC_READ_RATE_WINDOW_MS=
PUBLIC_READ_RATE_MAX=
MUTATION_RATE_WINDOW_MS=
MUTATION_RATE_MAX=
# User-based: «дорогие» действия по аккаунту (окно в мс, лимит за окно).
CREATE_TRIP_RATE_WINDOW_MS=
CREATE_TRIP_RATE_MAX=
CANCEL_TRIP_RATE_WINDOW_MS=
CANCEL_TRIP_RATE_MAX=
CREATE_BOOKING_RATE_WINDOW_MS=
CREATE_BOOKING_RATE_MAX=
CANCEL_BOOKING_RATE_WINDOW_MS=
CANCEL_BOOKING_RATE_MAX=
# Завершение поездок водителем (PATCH /trips/:id/complete).
COMPLETE_TRIP_RATE_WINDOW_MS=
COMPLETE_TRIP_RATE_MAX=
# User-based: частые лёгкие действия (профиль/машина, прочтение уведомлений,
# личные списки отзывов и обращений) — лимит в сутки.
PROFILE_UPDATE_RATE_WINDOW_MS=
PROFILE_UPDATE_RATE_MAX=
NOTIFICATION_READ_RATE_WINDOW_MS=
NOTIFICATION_READ_RATE_MAX=
REVIEWS_READ_RATE_WINDOW_MS=
REVIEWS_READ_RATE_MAX=
FEEDBACK_READ_RATE_WINDOW_MS=
FEEDBACK_READ_RATE_MAX=
# Админ-панель: статичный токен входа (пусто = панель выключена, 403 на всё).
ADMIN_TOKEN=
ADMIN_JWT_TTL_SECONDS=
ADMIN_LOGIN_RATE_WINDOW_MS=
ADMIN_LOGIN_RATE_MAX=
# Лимит GET-эндпоинтов админки (IP-based, выше публичного read-лимитера).
ADMIN_READ_RATE_WINDOW_MS=
ADMIN_READ_RATE_MAX=

# ─── Mini-app (Vite dev server) ─────────────────────────────────────────────
# VITE_API_TARGET: адрес бэкенда для прокси /api, включая WebSocket.
# Dev-дефолт — http://127.0.0.1:3011.
VITE_API_TARGET=

# VITE_API_URL: базовый URL API для собранного фронтенда (client.ts, WsProvider).
# Пусто = относительный /api/v1 (тот же origin). Задаётся при сборке (build-time).
VITE_API_URL=

# VITE_SENTRY_DSN: Sentry для фронтенда (ErrorBoundary, sentry.ts).
# Пусто = Sentry выключен. Задаётся при сборке (build-time).
VITE_SENTRY_DSN=

# VITE_ALLOWED_HOSTS: хосты (через запятую), которым разрешено обращаться
# к dev-серверу (туннель/домен). Пусто = только localhost + LAN IP.
# Пример: VITE_ALLOWED_HOSTS="my-tunnel.example.com"
VITE_ALLOWED_HOSTS=

# VITE_TG_PORT: порт dev-сервера telegram-app (npm run dev:tg). Дефолт — 3012.
# VITE_TG_PORT=3012

# BACKEND_PORT: порт dev-бэкенда (npm run dev). Дефолт — 3011 (dev).
# BACKEND_PORT=3011

# ─── Telegram Mini App staging (tg-migration-18/20) ─────────────────────────
# Bot token for initData HMAC validation (POST /api/v1/auth/telegram).
# REQUIRED in docker-compose staging/prod (compose fails fast without it).
# Empty locally = Telegram auth disabled (503), dev-bypass via ALLOW_DEV_AUTH.
TELEGRAM_BOT_TOKEN=
# initData freshness window, seconds (anti-replay). Default 3600.
TG_INIT_DATA_TTL_SECONDS=
# Telegram-auth rate limit: window ms + max per IP.
TG_AUTH_RATE_WINDOW_MS=
TG_AUTH_RATE_MAX=
# Comma-separated hosts served with telegram-app/dist.
TELEGRAM_HOSTS=
# Telegram notification delivery kill-switch (default true) + dedupe window ms.
TELEGRAM_DELIVERY_ENABLED=true
TG_NOTIFICATION_DEDUPE_WINDOW_MS=
# Trust X-Real-IP/X-Forwarded-For (only behind a proxy that rewrites them).
TRUST_PROXY=
# Explicit allowlist for dev mock-tokens (dev/test only, never production).
DEV_AUTH_USER_ALLOWLIST=
# JWT lifetimes, seconds.
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_SECONDS=
DEV_MOCK_TOKEN_TTL_SECONDS=
