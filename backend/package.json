{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push && prisma generate",
    "db:push:force": "prisma db push --accept-data-loss && prisma generate",
    "db:test:push": "dotenv -e .env.test -- prisma db push --accept-data-loss && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:cities": "tsx prisma/seed-cities.ts",
    "db:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "test": "dotenv -e .env.test -- vitest run",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage"
  },
  "dependencies": {
    "@edem/contracts": "*",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7",
    "@sentry/node": "^10.73.0",
    "@telegram-apps/init-data-node": "^2.0.10",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.3",
    "hono": "^4.13.5",
    "isomorphic-dompurify": "^3.19.0",
    "jose": "^6.2.10",
    "pg": "^8",
    "pino": "^9.14.0",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.21.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
