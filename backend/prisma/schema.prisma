generator client {
  provider               = "prisma-client"
  // Prisma 7: генерация в src (компилируется tsc в dist), gitignore'd.
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  // Prisma 7: URL подключения живёт в prisma.config.ts (env("DATABASE_URL")),
  // а не в схеме.
  provider = "postgresql"
}

model User {
  id                   String    @id @default(uuid())
  // VK-идентификатор удалён (tg-migration-26): платформа только Telegram.
  // Telegram-идентификатор (Mini App / bot). BigInt: TG user id давно
  // превысил Int32 (~7 млрд), Int не подходит. Синхронизация параллельных
  // запусков — upsert по unique + P2002-ретрай в auth-роуте.
  telegramUserId       BigInt?   @unique
  name                 String
  avatar               String
  rating               Float     @default(5.0)
  reviewsCount         Int       @default(0)
  tripsCount           Int       @default(0)
  isVerified           Boolean   @default(true)
  notificationsEnabled Boolean   @default(true)
  verifiedAt           DateTime?
  bannedAt             DateTime?
  // Причина бана (обязательна при бане через админку: 1..500 символов).
  // null для старых банов, выставленных до этого поля (UI показывает «Причина не указана»).
  banReason            String?
  // Согласие на сообщения бота (bot-api-approval-package §2): бот не может
  // написать первым, факт /start в чате с ботом фиксируется вебхуком
  // POST /bot/webhook/:secret и проставляет эту метку времени. null — чата
  // нет, фоновая доставка молча пропускается (не спамим просьбами).
  // /stop сбрасывает обратно в null.
  tgChatJoinedAt       DateTime?
  about                String?
  // Версия онбординга (слайдов), показанного пользователю; null — ещё не показан.
  // Админка может сбросить (PATCH /admin/users/:id/onboarding-reset).
  onboardingVersion    String?
  // Момент акцепта правовых документов (ConsentGate, версия "2"+).
  // Доказательство согласия по 152-ФЗ (ст. 9): onboardingVersion фиксирует
  // ЧТО принято, это поле — КОГДА. Проставляется POST /users/me/onboarding
  // (кнопка «Принять»), сбрасывается при удалении аккаунта и админ-сбросе
  // онбординга (повторный акцепт новой редакции перезапишет).
  consentAcceptedAt    DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  car           Car?
  driverTrips   Trip[]         @relation("DriverTrips")
  bookings      Booking[]      @relation("PassengerBookings")
  reviewsGiven  Review[]       @relation("AuthorReviews")
  reviewsRecv   Review[]       @relation("TargetReviews")
  notifications Notification[]
  refreshTokens RefreshToken[]
  feedbacks     Feedback[]
  rideRequests  RideRequest[]
  reportsMade   Report[] @relation("ReportReporter")
  reportsHandled Report[] @relation("ReportAdminActor")
  // Outbox не связан с User relation-полем: userId там денормализован
  // для per-user rate limit/дедупа, связь идёт через Notification.
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // booking_created, booking_confirmed, trip_cancelled
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries  NotificationDelivery[]

  @@index([userId, isRead, createdAt(sort: Desc)])
}

// Outbox фоновых доставок уведомлений (bot-api-approval-package §4):
// createNotification пишет inbox-запись (как раньше) плюс строку задачи
// здесь; воркер-диспетчер забирает, проверяет согласие/дедуп/лимиты.
// Shadow mode: внешних отправок нет (ADR telegram-notification-delivery —
// Bot API blocked), воркер только размечает исход. Когда продукт
// одобрит канал, сюда добавится реальный sendMessage-контур без смены
// схемы.
model NotificationDelivery {
  id             String    @id @default(uuid())
  notificationId String
  userId         String
  // Плановый канал доставки; сейчас всегда "telegram".
  channel        String    @default("telegram")
  type           String
  // pending -> processing -> delivered | skipped | failed
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  // Allowlist-маршрут из resolveTelegramDeepLink (без query/hash/PII).
  deepLink       String?
  // Краткий машинный код ошибки (не текст сообщения, без PII).
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([userId, type])
  @@index([notificationId])
}

model Car {
  id        String   @id @default(uuid())
  userId    String   @unique
  model     String
  color     String
  // Примета для узнавания машины (не обязательно госномер).
  // Опционально: null — водитель не указал.
  plate     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trip {
  id              String   @id @default(uuid())
  driverId        String
  fromCity        String
  fromAddress     String
  toCity          String
  toAddress       String
  // FK на справочник городов. Nullable, чтобы старые поездки (без FK)
  // продолжали работать. Снимок `fromCity`/`toCity` выше — единственный
  // источник правды для UI/поиска/уведомлений; FK нужен для аналитики
  // и для автодополнения в форме создания.
  fromCityId      String?
  toCityId        String?
  fromCityRef     City?    @relation("TripFromCity", fields: [fromCityId], references: [id], onDelete: SetNull)
  toCityRef       City?    @relation("TripToCity", fields: [toCityId], references: [id], onDelete: SetNull)
  departureAt     DateTime
  durationMinutes Int
  distanceKm      Float
  // DB-уровень: CHECK Trip_price_positive (price > 0),
  // Trip_seatsTotal_range (1..MAX_SEATS = 3),
  // Trip_seatsAvailable_nonnegative (>= 0).
  // Prisma CHECK не выражает — см. миграцию *compress_seats_to_max3.
  price           Int
  seatsTotal      Int
  seatsAvailable  Int
  tags            String[] @default([])
  comment         String?
  status          String   @default("active") // active, cancelled, completed
  cancelledAt     DateTime?
  cancelledByType String?
  cancelledByUserId String?
  cancellationReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  driver   User      @relation("DriverTrips", fields: [driverId], references: [id])
  bookings Booking[]
  reviews  Review[]

  @@index([status, departureAt(sort: Asc)])
  @@index([driverId, status])
  @@index([driverId, status, departureAt(sort: Asc)])
  @@index([fromCity, toCity, status])
  @@index([fromCityId])
  @@index([toCityId])
}

// Справочник точек (городов) для автодополнения. Маленький городок →
// конечный список, которым управляет админ. UI мини-апа НЕ позволяет
// вводить город вручную — только выбор из справочника.
model City {
  id             String   @id @default(uuid())
  // Имя города. Нормализуется в API (trim, схлопывание пробелов).
  // Ограничение 1..100 символов — на уровне Zod DTO.
  name           String
  // Нормализованное имя (lower + trim) — для регистронезависимой
  // уникальности. `nameNormalized` хранится уже в lowercase-форме
  // (нормализация в коде через `cityNameNormalized`), поэтому это
  // обычная колонка String с @unique — выражений/функций нет, Prisma
  // создаёт индекс автоматически. db:push и migrate deploy оба
  // гарантируют UNIQUE INDEX, что критично для проверки дубликатов
  // (P2002) в POST /admin/cities.
  nameNormalized String   @unique
  // Счётчик НЕ отменённых поездок с этим городом (для отображения в
  // админке и предотвращения удаления используемого города).
  // Денормализация ради O(1) проверки «можно ли удалить» и быстрого
  // отображения в UI. Меняется только через cities/counters.ts (F17):
  // инкремент при создании поездки, guarded-декремент при отмене
  // (tripsCount > 0), пересчёт — POST /admin/cities/
  // recompute-trips-count. DB: CHECK City_tripsCount_nonnegative
  // (миграция *city_tripscount_guard).
  tripsCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tripsFrom Trip[] @relation("TripFromCity")
  tripsTo   Trip[] @relation("TripToCity")
  rideRequestsFrom RideRequest[] @relation("RideRequestFromCity")
  rideRequestsTo   RideRequest[] @relation("RideRequestToCity")

  @@index([name])
}

model RideRequest {
  id              String   @id @default(uuid())
  userId          String
  fromCityId      String
  toCityId        String
  earliestAt      DateTime
  latestAt        DateTime
  seats           Int      @default(1)
  status          String   @default("active") // active, paused, fulfilled, expired, cancelled
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromCity   City @relation("RideRequestFromCity", fields: [fromCityId], references: [id], onDelete: Restrict)
  toCity     City @relation("RideRequestToCity", fields: [toCityId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([fromCityId, toCityId, status, earliestAt])
  @@index([userId, status])
}

model Report {
  id              String   @id @default(uuid())
  reporterId      String
  targetType      String   // user, trip, booking
  targetId        String
  category        String   // safety, fraud, harassment, spam, inaccurate_info, other
  description     String
  status          String   @default("pending") // pending, in_review, resolved, rejected
  resolutionNote  String?
  adminActorId    String?
  adminActorType  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resolvedAt      DateTime?

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  adminActor User? @relation("ReportAdminActor", fields: [adminActorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId, status])
  @@index([reporterId, targetType, targetId, category])
  // Одна жалоба навсегда на связку (автор, объект): категория и статус
  // не входят в ключ — повтор невозможен даже после рассмотрения.
  // Заменяет частичный индекс Report_open_unique_idx (см. миграцию
  // *report_open_unique — удалён миграцией *report_one_per_reporter_target).
  @@unique([reporterId, targetType, targetId])
}

model Booking {
  id          String   @id @default(uuid())
  tripId      String
  passengerId String
  // DB CHECK Booking_seat_positive (seat >= 1) — см. миграцию *compress_seats_to_max3.
  seat        Int
  status      String   @default("pending") // pending, confirmed, declined, cancelled
  expiresAt   DateTime?
  cancelledAt DateTime?
  cancelledByType String?
  cancelledByUserId String?
  cancellationReason String?
  comment     String?
  createdAt   DateTime @default(now())

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passenger User @relation("PassengerBookings", fields: [passengerId], references: [id])

  @@index([tripId, status])
  @@index([status, expiresAt])
  @@index([passengerId, status])
  @@index([tripId, seat])
  @@index([tripId, passengerId])
  @@index([tripId, createdAt(sort: Desc)])
}

// Partial unique constraints создаются SQL-миграцией (Prisma не поддерживает
// `where` в @@unique):
// - active_seat_booking (tripId, seat) WHERE status IN ('pending', 'confirmed')
// - active_passenger_booking (tripId, passengerId) WHERE status IN ('pending', 'confirmed')
// См. prisma/migrations/*_booking_unique_indexes/migration.sql
// (F15: предикат намеренно исключает declined/cancelled — отклонённая бронь
// освобождает слот, повторная подача на то же место разрешена; pre-check'и
// POST /bookings обязаны использовать тот же предикат через
// ACTIVE_BOOKING_STATUSES. Миграция *_booking_resubmit_after_decline
// идемпотентно фиксирует оба индекса.)

model Review {
  id           String   @id @default(uuid())
  authorId     String
  targetUserId String
  targetRole   String // passenger, driver
  // DB CHECK Review_rating_range (1..5, как контракт review.schema) —
  // см. миграцию *compress_seats_to_max3.
  rating       Int
  text         String
  tripRoute    String
  status       String   @default("pending") // pending, published, rejected
  createdAt    DateTime @default(now())

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  author     User @relation("AuthorReviews", fields: [authorId], references: [id])
  targetUser User @relation("TargetReviews", fields: [targetUserId], references: [id])

  // Имя индекса — дефолтное Prisma (Review_authorId_tripId_targetUserId_key):
  // миграция 20260811174647 переименовала unique_review_per_trip в него,
  // поэтому явный name здесь вызывал бы дрейф schema/migrations.
  @@unique([authorId, tripId, targetUserId])
  // NULL-safety (F14): PostgreSQL в unique-индексе считает NULL «разными»,
  // поэтому полный индекс выше не ловит дубли (authorId, targetUserId) при
  // tripId IS NULL (legacy-отзывы, удалённая поездка — FK onDelete: SetNull).
  // Partial-индекс (authorId, targetUserId) WHERE tripId IS NULL создаётся
  // SQL-миграцией (Prisma не поддерживает `where` в @@unique — как и
  // partial-индексы Booking выше):
  // prisma/migrations/*_review_unique_null_trip/migration.sql.
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([targetUserId, status])
  @@index([authorId, tripId])
}

// Обращения пользователей в поддержку (Профиль → Помощь и поддержка).
model Feedback {
  id        String    @id @default(uuid())
  userId    String
  subject   String
  text      String
  // Ответ админа (≤ 2000 символов). null = ещё не отвечено.
  // `repliedAt` проставляется сервером при первом ответе; при редактировании
  // ответа сохраняем исходное время (аудит «когда был дан ответ»).
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([repliedAt])
}
